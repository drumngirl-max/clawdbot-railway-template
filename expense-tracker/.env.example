# Токен бота от @BotFather (обязательно в проде)
BOT_TOKEN=123456789:AA-your-token-here

# Порт (Railway задаёт автоматически)
PORT=8080

# Символ валюты
CURRENCY=₽

# Каталог для JSON-хранилища. На Railway укажите путь на волюме, напр. /data
DATA_DIR=./data

# Публичный URL Mini App (нужен только для скрипта setup-bot.js)
WEBAPP_URL=https://your-app.up.railway.app

# Локальная разработка без Telegram (НЕ включать в проде): 1 отключает проверку подписи
# ALLOW_INSECURE_DEV=1
